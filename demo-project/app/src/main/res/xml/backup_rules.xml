<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 o inferior (API ≤ 30). Laika opera en red cerrada y maneja datos médicos:
   se excluye todo de la copia de seguridad. Ver docs/11-red-cerrada.md
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
