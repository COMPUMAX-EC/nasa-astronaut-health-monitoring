{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd app && npm ci",
  "buildCommand": "cd app && npm run build && mkdir -p dist/presentacion && cp -r ../entregables/diapositivas/index.html ../entregables/diapositivas/media dist/presentacion/",
  "outputDirectory": "app/dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(self), geolocation=()"
        }
      ]
    }
  ]
}
